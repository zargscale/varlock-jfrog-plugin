# @plugin(../)
# @initJfrog(url=$JFROG_URL, token=$JFROG_TOKEN, allowWebLogin=true)
# ---

# Platform root, for example https://your-company.jfrog.io (no /ui or /artifactory).
# @type=url @required
JFROG_URL=

# Optional existing token; leave unset to use browser login.
# @type=jfrogAccessToken @sensitive @internal
JFROG_TOKEN=

# @type=jfrogAccessToken @sensitive @required
JFROG_ACCESS_TOKEN=jfrogToken()
